{
  "name": "06 - AI Customer Recall Automation (Smart Re-engagement)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 13 * * 2,5"
            }
          ]
        }
      },
      "name": "Weekly Schedule Trigger (Recall)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "id": "recall-schedule-trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://trimmind.up.railway.app/api/agent-tools/recall/candidates",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-agent-secret",
              "value": "trim-mind-agent-secret-key-2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "branchId",
              "value": "branch-elhdad"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Lapsed Customers from TrimMind DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        440,
        300
      ],
      "id": "fetch-recall-candidates"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const item of items) {\n  const list = item.json.data || [];\n  for (const c of list) {\n    if (c.customer_phone) {\n      out.push({\n        json: {\n          phone: c.customer_phone,\n          customerName: c.customer_name || 'عميلنا العزيز',\n          lastBarber: c.last_barber || 'كابتن الصالون',\n          lastService: c.last_service || 'حلاقة VIP',\n          daysSince: c.days_since_last_visit || 40\n        }\n      });\n    }\n  }\n}\nreturn out.slice(0, 10);"
      },
      "name": "Format Candidates Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "id": "format-recall-batch"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=اكتب رسالة واتساب شخصية وودية جداً باللهجة المصرية لعميل صالون TrimMind لم يزر الصالون منذ {{ $json.daysSince }} يوماً:\nالاسم: {{ $json.customerName }}\nالحلاق المفضل السابق: {{ $json.lastBarber }}\nآخر خدمة: {{ $json.lastService }}",
        "options": {
          "systemMessage": "أنت مسؤول العناية بالعملاء لصالون TrimMind (صالون الحداد VIP).\nاكتب رسالة واتساب قصيرة جداً (3 أسطر فقط)، دافئة وأنيقة باللهجة المصرية تعبر عن أن العميل وحشنا جداً في الصالون منذ آخر حلاقة له مع كابتن الحلاقة المذكور.\nاسأله بود إن كان يحب نجهز له موعد ونحجز له الكرسي هذا الأسبوع، وأخبره أنه يقدر يحجز مباشرة بمجرد الرد على هذه الرسالة! 💈👑✨"
        }
      },
      "name": "Generate Personalized Recall Message",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        920,
        300
      ],
      "id": "generate-recall-msg"
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {
          "temperature": 0.4
        }
      },
      "name": "Gemini Model Recall",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        920,
        520
      ],
      "id": "gemini-recall-model",
      "credentials": {
        "googlePalmApi": {
          "id": "Vehz1Y7tl0gRunMN",
          "name": "Google Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://trimmind.up.railway.app/api/whatsapp-session/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-agent-secret",
              "value": "trim-mind-agent-secret-key-2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "to",
              "value": "={{ $('Format Candidates Batch').item.json.phone }}"
            },
            {
              "name": "text",
              "value": "={{ $json.text || $json.output }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Send Recall Message via WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1160,
        300
      ],
      "id": "send-recall-whatsapp"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://trimmind.up.railway.app/api/agent-tools/recall/log-send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-agent-secret",
              "value": "trim-mind-agent-secret-key-2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $('Format Candidates Batch').item.json.phone }}"
            },
            {
              "name": "customerName",
              "value": "={{ $('Format Candidates Batch').item.json.customerName }}"
            },
            {
              "name": "messageText",
              "value": "={{ $('Generate Personalized Recall Message').item.json.text || $('Generate Personalized Recall Message').item.json.output }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Log Campaign Send in TrimMind DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1400,
        300
      ],
      "id": "log-recall-send"
    }
  ],

      "parameters": {
        "jsCode": "const rawText = $json.text || $json.body?.text || $json.body?.message || '';\n\nif (!rawText || !rawText.trim()) {\n  return [];\n}\n\nconst now = new Date();\nconst cairoDate = new Date(now.toLocaleString('en-US', { timeZone: 'Africa/Cairo' }));\n\nconst formatDate = (d) => {\n  const y = d.getFullYear();\n  const m = String(d.getMonth() + 1).padStart(2, '0');\n  const day = String(d.getDate()).padStart(2, '0');\n  return `${y}-${m}-${day}`;\n};\n\nconst daysArabic = ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];\n\nconst d0 = new Date(cairoDate);\nconst todayStr = formatDate(d0);\nconst todayName = daysArabic[d0.getDay()];\n\nconst d1 = new Date(cairoDate);\nd1.setDate(d1.getDate() + 1);\nconst tomorrowStr = formatDate(d1);\nconst tomorrowName = daysArabic[d1.getDay()];\n\nconst d2 = new Date(cairoDate);\nd2.setDate(d2.getDate() + 2);\nconst afterTomorrowStr = formatDate(d2);\nconst afterTomorrowName = daysArabic[d2.getDay()];\n\nconst rawPhone = $json.realPhone || $json.phone || $json.body?.phone || '';\nlet cleanPhone = rawPhone.replace(/@.*/, '').replace(/[^0-9]/g, '');\nif (cleanPhone.startsWith('20') && cleanPhone.length === 12) {\n  cleanPhone = '0' + cleanPhone.substring(2);\n}\nconst isRealPhone = cleanPhone.startsWith('01') && cleanPhone.length === 11;\nconst pushName = $json.pushName || $json.body?.pushName || 'العميل';\n\nconst phoneInfo = isRealPhone ? `رقم هاتف العميل الحالي هو (${cleanPhone})` : 'رقم هاتف العميل غير محدد صراحة (يرجى التأكد من رقم هاتفه)';\n\nconst metadataContext = `[معلومات الجلسة: ${phoneInfo} | اسم حساب الواتساب: (${pushName})]`;\nconst dateContext = `[تقويم مصر: اليوم هو ${todayName} ${todayStr} | غداً هو ${tomorrowName} ${tomorrowStr} | بعد غد هو ${afterTomorrowName} ${afterTomorrowStr}]`;\n\nreturn [{\n  json: {\n    sessionId: cleanPhone || $json.remoteJid || 'default_user',\n    customerPhone: isRealPhone ? cleanPhone : '',\n    customerName: pushName,\n    chatInput: `${metadataContext}\\n${dateContext}\\nرسالة العميل: ${rawText.trim()}`\n  }\n}];"
      },

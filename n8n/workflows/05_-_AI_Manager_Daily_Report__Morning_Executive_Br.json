      "ai_languageModel": [
        [
          {
            "node": "AI Summary Generator",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Summary Generator": {
      "main": [
        [
          {
            "node": "Send Report to Manager via WhatsApp",

{
  "name": "04 - Appointment Reminders Cron (Scheduled WhatsApp Notifications)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "Hourly Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_API_URL || 'https://trimmind.up.railway.app' }}/api/agent-tools/reminders/upcoming",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-agent-secret",
              "value": "={{ $env.AGENT_API_SECRET || 'trim-mind-agent-secret-key-2026' }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "hoursAhead",
              "value": 24
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Upcoming Appointments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "name": "Item Splitter",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 2.1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $json;\nconst dateObj = new Date(item.startsAt);\nconst timeStr = dateObj.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });\nconst dateStr = dateObj.toLocaleDateString('ar-EG', { weekday: 'long', day: 'numeric', month: 'short' });\n\nconst reminderText = `أهلاً بك يا ${item.customerName} 👋✨\\n\\nحبينا نفكرك بموعدك القادم في الصالون:\\n💈 الخدمة: ${item.serviceName}\\n✂️ مع الكابتن: ${item.barberName}\\n🗓️ الموعد: ${dateStr} الساعة ${timeStr}\\n🏢 الفرع: ${item.branchName}\\n\\nلو حابب تعدل الموعد أو تستفسر عن أي حاجة، رد علينا مباشرة هنا ويسعدنا نخدمك! 👑`;\n\nreturn [{\n  json: {\n    phone: item.customerPhone,\n    reminderText,\n    bookingId: item.bookingId\n  }\n}];"
      },
      "name": "Compose Natural Reminder Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL || 'https://evolution.yourdomain.com' }}/message/sendText/default",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY || 'your-evolution-api-key' }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "text",
              "value": "={{ $json.reminderText }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Send WhatsApp Reminder via Evolution API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        300
      ]
    }
  ],
  "connections": {
    "Hourly Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Upcoming Appointments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Upcoming Appointments": {
      "main": [
        [
          {
            "node": "Item Splitter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Item Splitter": {
      "main": [
        [
          {
            "node": "Compose Natural Reminder Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose Natural Reminder Message": {
      "main": [
        [
          {
            "node": "Send WhatsApp Reminder via Evolution API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

          "jsCode": "const body = $json.body || $json;\nconst data = body.data || {};\nconst key = data.key || {};\nconst messageId = key.id || data.id || body.id;\nconst fromMe = key.fromMe || body.fromMe;\nconst remoteJid = key.remoteJid || data.remoteJid || body.remoteJid || '';\nconst pushName = data.pushName || body.pushName || '???? ???????';\n\nif (fromMe) {\n  return [];\n}\n\nlet cleanPhone = body.senderPhone || data.senderPhone || '';\nif (!cleanPhone) {\n  const candidate = key.remoteJidAlt || key.participant || data.participant || remoteJid;\n  cleanPhone = candidate.replace('@s.whatsapp.net', '').replace('@c.us', '').replace('@lid', '').replace(/[^0-9]/g, '');\n  if (cleanPhone.startsWith('20') && cleanPhone.length === 12) {\n    cleanPhone = '0' + cleanPhone.substring(2);\n  }\n}\n\n// If cleanPhone is a LID (not starting with 01 or length != 11), clear it so AI asks for phone\nif (!cleanPhone.startsWith('01') || cleanPhone.length !== 11) {\n  cleanPhone = '';\n}\n\nconst message = data.message || body.message || {};\nconst isImage = Boolean(message.imageMessage || body.isImage || body.imageUrl || data.imageUrl);\nconst imageUrl = body.imageUrl || data.imageUrl || data.mediaUrl || body.mediaUrl || null;\n\nconst textMessage = message.conversation || \n                    message.extendedTextMessage?.text || \n                    message.imageMessage?.caption || \n                    message.documentMessage?.caption || \n                    body.text || '';\n\nif (!textMessage.trim() && !isImage) {\n  return [];\n}\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.seenTextKeys = staticData.seenTextKeys || {};\nstaticData.lastImageTime = staticData.lastImageTime || {};\n\nconst now = Date.now();\nconst textKey = (textMessage || 'img_placeholder').trim().toLowerCase();\n\nif (isImage) {\n  staticData.lastImageTime[cleanPhone || remoteJid] = now;\n} else if (staticData.lastImageTime[cleanPhone || remoteJid] && (now - staticData.lastImageTime[cleanPhone || remoteJid] < 8000)) {\n  return [];\n}\n\nif (textKey && staticData.seenTextKeys[textKey]) {\n  const lastTime = staticData.seenTextKeys[textKey];\n  if (now - lastTime < 6000) {\n    return [];\n  }\n}\nif (textKey) {\n  staticData.seenTextKeys[textKey] = now;\n}\n\nreturn [{\n  json: {\n    messageId: messageId || textKey,\n    remoteJid,\n    phone: cleanPhone || remoteJid.replace('@s.whatsapp.net', '').replace('@lid', ''),\n    realPhone: cleanPhone,\n    pushName,\n    chatInput: textMessage,\n    text: textMessage,\n    input: textMessage,\n    isImage,\n    imageUrl: imageUrl,\n    mediaUrl: imageUrl,\n    rawMessage: message,\n    instance: body.instance || 'default',\n    timestamp: new Date().toISOString()\n  }\n}];"

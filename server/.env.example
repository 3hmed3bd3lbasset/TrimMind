NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL Configuration (Railway MySQL / Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=salon_db

# Security & JWT
JWT_SECRET=super_secret_jwt_key_for_elite_salon_platform_production
JWT_EXPIRES_IN=24h

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Gemini AI Secret Keys (Accessed strictly server-side on Railway/Server)
GEMINI_API_KEY_CUSTOMER=your_gemini_key_here
GEMINI_API_KEY_MANAGER=your_gemini_key_here
GEMINI_API_KEY_RECEPTIONIST=your_gemini_key_here
GEMINI_API_KEY_BARBER=your_gemini_key_here

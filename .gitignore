# 1. Dependencies (مجلدات الحزم - لا ترفع لأنها ثقيلة جداً ويتم تثبيتها تلقائياً)
node_modules/
server/node_modules/
.pnp
.pnp.js

# 2. Environment Variables & Secret Keys (الملفات السرية ومفاتيح الـ API - خط أحمر)
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# 3. Production Builds & Cache (مخرجات البناء والملفات المؤقتة)
dist/
build/
*.tsbuildinfo
.eslintcache

# 4. Databases & Storage (ملفات قواعد البيانات المحلية والمرفوعات)
*.db
*.sqlite
*.sqlite3
server/database.sqlite
server/uploads/*
!server/uploads/.gitkeep
temp/
*.zip

# 5. Logs & Debuggers (سجلات الأخطاء)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. IDE & OS Files (ملفات النظام ومحرر الأكواد)
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gemini/
